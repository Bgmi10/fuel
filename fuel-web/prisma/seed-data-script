// =====================================================
// DATE HELPERS (Asia/Kolkata)
// =====================================================

const TZ = "Asia/Kolkata";
const DAY = 86_400_000;
const NOW = new Date();

const addDays = (d: Date, n: number) => new Date(d.getTime() + n * DAY);

const dateKeyOf = (d: Date) =>
  new Intl.DateTimeFormat("en-CA", {
    timeZone: TZ,
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).format(d); // YYYY-MM-DD

/** "YYYY-MM-DD" for today + n days */
const dayKey = (n: number) => dateKeyOf(addDays(NOW, n));

/** Midnight (IST) of today + n days */
const dayStart = (n: number) => new Date(`${dayKey(n)}T00:00:00+05:30`);

/** Specific time (IST) on today + n days */
const at = (n: number, hh: number, mm = 0) =>
  new Date(
    `${dayKey(n)}T${String(hh).padStart(2, "0")}:${String(mm).padStart(2, "0")}:00+05:30`
  );

const pad = (n: number, len = 4) => String(n).padStart(len, "0");

const sha256 = (value: string) =>
  createHash("sha256").update(value).digest("hex");

// =====================================================
// MONEY / TAX HELPERS
// =====================================================

const GST = 9; // % each for CGST and SGST (matches Setting below)

function priced(base: number, discount = 0, referralDiscount = 0) {
  const taxable = base - discount - referralDiscount;
  const cgstAmount = +((taxable * GST) / 100).toFixed(2);
  const sgstAmount = cgstAmount;
  const totalTax = +(cgstAmount + sgstAmount).toFixed(2);

  return {
    packageAmount: base,
    discountAmount: discount,
    referralDiscountAmount: referralDiscount,
    cgstPercentage: GST,
    sgstPercentage: GST,
    cgstAmount,
    sgstAmount,
    totalTax,
    finalAmount: Math.round(taxable + totalTax),
  };
}

let invoiceSeq = 1;
let receiptSeq = 1;
const YEAR = NOW.getFullYear();

type PaymentSpec = {
  type: PaymentType;
  /** fraction of the invoice's final amount, e.g. 0.5 */
  ratio: number;
  mode: "CASH" | "UPI" | "CARD" | "ONLINE";
  status?: InvoicePaymentStatus;
  daysAfter?: number;
};

type InvoiceOpts = {
  member: Member;
  branch: Branch;
  service: Service;
  pkg: ServicePackage;
  subCategory?: ServiceSubCategory | null;
  intent: InvoiceIntent;
  discount?: number;
  referralDiscount?: number;
  baseAmount?: number;
  status?: InvoiceStatus;
  salesRep?: User | null;
  linkedSubscriptionId?: string | null;
  groupMemberCount?: number;
  groupDiscountPercentage?: number;
  notes?: string;
  createdDaysAgo?: number;
  payments?: PaymentSpec[];
};

async function makeInvoice(o: InvoiceOpts) {
  const base = o.baseAmount ?? o.pkg.price;
  const t = priced(base, o.discount ?? 0, o.referralDiscount ?? 0);

  const payments = (o.payments ?? []).map((p) => ({
    ...p,
    amount: Math.round(t.finalAmount * p.ratio),
    status: (p.status ?? "PAID") as InvoicePaymentStatus,
  }));

  const paid = payments
    .filter((p) => p.status === "PAID")
    .reduce((sum, p) => sum + p.amount, 0);

  const status: InvoiceStatus =
    o.status ??
    (paid === 0 ? "PENDING" : paid >= t.finalAmount ? "FULLY_PAID" : "PARTIAL_PAID");

  const createdAt = addDays(NOW, -(o.createdDaysAgo ?? 0));

  const invoice = await prisma.invoice.create({
    data: {
      invoiceNumber: `INV-${YEAR}-${pad(invoiceSeq++)}`,
      memberId: o.member.id,
      branchId: o.branch.id,
      packageId: o.pkg.id,
      subCategoryId: o.subCategory?.id ?? null,
      linkedSubscriptionId: o.linkedSubscriptionId ?? null,
      salesRepId: o.salesRep?.id ?? null,
      salesRepName: o.salesRep?.name ?? null,
      intent: o.intent,
      serviceName: o.service.name,
      packageName: o.pkg.name,
      packageDurationInDays: o.pkg.durationInDays,
      branchName: o.branch.name,
      memberName: o.member.name,
      memberPhone: o.member.phone,
      memberEmail: o.member.email,
      ...t,
      paidAmount: paid,
      balanceAmount: status === "CANCELLED" ? 0 : t.finalAmount - paid,
      status,
      groupMemberCount: o.groupMemberCount ?? null,
      groupDiscountPercentage: o.groupDiscountPercentage ?? null,
      notes: o.notes ?? null,
      createdAt,
    },
  });

  for (const p of payments) {
    await prisma.payment.create({
      data: {
        receiptNumber: `RCPT-${YEAR}-${pad(receiptSeq++)}`,
        invoiceId: invoice.id,
        memberId: o.member.id,
        amount: p.amount,
        paymentMode: p.mode,
        paymentType: p.type,
        status: p.status,
        ...(p.mode === "ONLINE"
          ? {
              razorpayOrderId: `order_TEST${pad(receiptSeq, 6)}`,
              razorpayPaymentId: `pay_TEST${pad(receiptSeq, 6)}`,
              razorpaySignature: sha256(`sig-${invoice.id}-${receiptSeq}`),
            }
          : {}),
        paidAt: addDays(createdAt, p.daysAfter ?? 0),
        createdAt,
      },
    });
  }

  return { invoice, totals: t };
}

type SubscriptionOpts = {
  member: Member;
  branch: Branch;
  service: Service;
  pkg: ServicePackage;
  subCategory?: ServiceSubCategory | null;
  invoiceId?: string | null;
  /** negative = started in the past */
  startOffsetDays: number;
  status: SubscriptionStatus;
  finalPrice: number;
  originalPrice?: number | null;
  remainingSessions?: number | null;
  freezeStartOffset?: number;
  freezeEndOffset?: number;
  endOverride?: Date;
};

async function makeSubscription(o: SubscriptionOpts) {
  const startDate = dayStart(o.startOffsetDays);
  const endDate = o.endOverride ?? addDays(startDate, o.pkg.durationInDays);

  return prisma.subscription.create({
    data: {
      memberId: o.member.id,
      branchId: o.branch.id,
      packageId: o.pkg.id,
      subCategoryId: o.subCategory?.id ?? null,
      invoiceId: o.invoiceId ?? null,
      serviceName: o.service.name,
      packageName: o.pkg.name,
      packageDurationInDays: o.pkg.durationInDays,
      originalPrice: o.originalPrice ?? o.pkg.originalPrice ?? null,
      finalPrice: o.finalPrice,
      branchName: o.branch.name,
      usageType: o.pkg.usageType,
      totalSessions: o.pkg.totalSessions ?? null,
      remainingSessions: o.remainingSessions ?? null,
      startDate,
      endDate,
      freezeStart:
        o.freezeStartOffset !== undefined ? dayStart(o.freezeStartOffset) : null,
      freezeEnd:
        o.freezeEndOffset !== undefined ? dayStart(o.freezeEndOffset) : null,
      status: o.status,
      createdAt: startDate,
    },
  });
}

